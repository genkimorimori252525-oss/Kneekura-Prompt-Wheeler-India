{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kneekura Prompt Wheeler",
  "version": "0.1.0",
  "identifier": "com.kneekura.promptwheeler",
  "build": {
    "beforeDevCommand": "npm run desktop:serve",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run desktop:prepare",
    "frontendDist": "../desktop-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Kneekura Prompt Wheeler",
        "width": 430,
        "height": 675,
        "minWidth": 360,
        "minHeight": 460,
        "center": true,
        "resizable": true,
        "alwaysOnTop": true,
        "decorations": true,
        "theme": "Dark",
        "backgroundColor": "#0b1020"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
